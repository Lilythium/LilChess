# Copy to .env. With Docker Compose use `env_file: .env`.
# (Compose env_file does not strip inline comments, so comments live on their own lines.)

PORT=3000
DATA_DIR=./data

# open | invite | closed
REGISTRATION=open
# Required when REGISTRATION=invite
INVITE_CODE=

# The first administrator, set up on startup while no administrator exists.
# An existing registered username is promoted. A new username is created if ADMIN_PASSWORD is set too,
# which is how to get started with REGISTRATION=closed. Remove ADMIN_PASSWORD once the account exists.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Let visitors with an invite link play without an account (ignored when REGISTRATION=closed)
ALLOW_GUESTS=true

# Minimum rated games required for leaderboard eligibility
LEADERBOARD_MIN_GAMES=5
# Hide inactive players from the rating leaderboard after this many days; 0 disables hiding
LEADERBOARD_INACTIVE_DAYS=30

# Public origin, e.g. https://chess.example.com or http://192.168.1.50:3000.
# Pins the allowed Origin (CSRF + WebSocket) and decides whether cookies are Secure.
# Leave unset in dev so the Vite proxy works.
BASE_URL=

# Number of reverse-proxy hops in front of the server (1 for Caddy/Traefik).
# Needed so per-IP rate limits see real client IPs. Leave unset if not behind a proxy.
TRUST_PROXY=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Nightly SQLite backup (UTC hour). BACKUP_KEEP=0 disables.
BACKUP_KEEP=7
BACKUP_HOUR_UTC=3
# BACKUP_DIR defaults to $DATA_DIR/backups

# Optional server-wide webhook. It receives user notifications and correspondence-game events.
# Set WEBHOOK_KIND=ntfy for ntfy; Discord webhook URLs are detected automatically (or set discord).
WEBHOOK_URL=
WEBHOOK_KIND=

# Optional email (notifications + password reset). Leave SMTP_HOST empty to keep email off.
# When set, SMTP_FROM and BASE_URL are required (emails contain links to BASE_URL).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); false for STARTTLS on 587
SMTP_SECURE=false
# Set both or neither
SMTP_USER=
SMTP_PASS=
# e.g. noreply@chess.example.com
SMTP_FROM=

# Optional Discord notifications. Create a webhook in a channel (Channel settings > Integrations > Webhooks)
# and paste its URL. Players opt in by giving their Discord user ID in Settings; they are @mentioned in
# that channel. BASE_URL is required (messages contain links). Leave empty to keep Discord off.
DISCORD_WEBHOOK_URL=

# Optional verified https links into the mobile app (Android App Links, iOS universal links). When set, the server
# serves /.well-known/assetlinks.json and /.well-known/apple-app-site-association; when empty both return 404.
# Android: SHA-256 fingerprint(s) of the app signing certificate, comma-separated (AA:BB:...:FF).
# iOS: "<TeamID>.<bundle id>", comma-separated. See docs/mobile-phase-7-platform.md.
MOBILE_ANDROID_CERT_SHA256=
MOBILE_IOS_APP_ID=
# Only change if you build and sign the app under your own package id.
# MOBILE_ANDROID_PACKAGE=io.github.lilythium.lilchess

# Public demo server (for app-store reviewers and first-time visitors). Leave off for a normal server.
# Adds a practice bot ("demo_bot") and lets guests start a game without an invite link. Needs ALLOW_GUESTS=true and
# REGISTRATION not closed. Run it as its own dedicated instance with its own data: see docs/mobile-demo-server.md.
DEMO_MODE=false
# Demo guests and their bot games are deleted once older than this many hours (1-720)
DEMO_RETENTION_HOURS=24
