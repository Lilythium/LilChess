{
  "name": "lilchess",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted, lightweight chess server with accounts, live & correspondence play, and per-opponent history.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "web",
    "mobile"
  ],
  "scripts": {
    "predev": "npm run build -w shared",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w web",
    "pretest": "npm run build -w shared",
    "test": "vitest run",
    "lint": "eslint .",
    "check:leaks": "node scripts/check-token-leaks.mjs",
    "bench:chess-main-thread": "npm run build -w shared && tsx scripts/bench-chess-main-thread.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lilythium/LilChess.git"
  },
  "bugs": {
    "url": "https://github.com/Lilythium/LilChess/issues"
  },
  "homepage": "https://github.com/Lilythium/LilChess#readme",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.7"
  }
}
