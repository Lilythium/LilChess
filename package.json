{
  "name": "lilchess",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted, lightweight chess server with accounts, live & correspondence play, and per-opponent history.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "predev": "npm run build -w shared",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w web",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lilythium/LilChess.git"
  },
  "bugs": {
    "url": "https://github.com/Lilythium/LilChess/issues"
  },
  "homepage": "https://github.com/Lilythium/LilChess#readme",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0"
  }
}
